# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Image API (OnlyPepes)
IMAGE_API_BASE=https://onlypepes.com

# Qdrant RAG (Cloud)
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=professor_pepe

# Watermark image (relative to backend/ or absolute path)
WATERMARK_PATH=assets/watermark.png

# Rare Pepe local directory (optional; Qdrant collection "pepe_memes" is used first)
MEMES_DIR=./memes

# On-chain explorers, tried in order until one answers (comma-separated).
# All Pepecoin explorers sit behind Cloudflare, which may reject requests from
# a datacenter IP. If the logs show "No explorer reachable", reorder this list
# or add a mirror that your host can reach.
PEPE_EXPLORERS=https://pepeblocks.com,https://pepeplorer.com
